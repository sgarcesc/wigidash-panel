    "cpuTemp": {
      "name": "^CPU$",
      "source": "^CPU \\[#0\\]",
      "unit": "C",
      "demo": 52
    },
    "cpuClock": {
      "name": "^Core \\d+ Clock$",
      "source": "^CPU \\[#0\\]",
      "aggregate": "avg",
      "demo": 5225
    },
    "cpuPower": {
      "name": "^CPU Package Power$",
      "demo": 63.4
    },
    "cpuLoad": {
      "name": "^Total CPU Usage$",
      "demo": 24
    },
    "memUsed": {
      "name": "^Physical Memory Used$",
      "scale": 0.0009765625,
      "demo": 17.4
    },
    "memTotal": {
      "name": "^Physical Memory (Used|Available)$",
      "aggregate": "sum",
      "scale": 0.0009765625,
      "demo": 61.7
    },
    "memLoad": {
      "name": "^Physical Memory Load$",
      "demo": 28
    },
    "gpuTemp": {
      "name": "^GPU Temperature$",
      "source": "^[di]?GPU \\[#0\\]",
      "demo": 61
    },
    "gpuClock": {
      "name": "^GPU Clock$",
      "source": "^[di]?GPU \\[#0\\]",
      "demo": 2655
    },
