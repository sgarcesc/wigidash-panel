      "name": "^GPU Power$",
      "source": "^[di]?GPU \\[#0\\]",
      "unit": "^W$",
      "demo": 412
    },
    "gpuLoad": {
      "name": "^GPU Core Load$",
      "source": "^[di]?GPU \\[#0\\]",
      "demo": 87
    },
    "vramUsed": {
      "name": "^GPU Memory Allocated$",
      "source": "^[di]?GPU \\[#0\\]",
      "scale": 0.0009765625,
      "demo": 11.6
    },
    "vramTotal": {
      "name": "^GPU Memory (Allocated|Available)$",
      "source": "^[di]?GPU \\[#0\\]",
      "aggregate": "sum",
      "scale": 0.0009765625,
      "demo": 31.8
    },
    "vramLoad": {
      "name": "^GPU Memory Usage$",
      "source": "^[di]?GPU \\[#0\\]",
      "unit": "%",
      "demo": 36
    },
    "fps": {
      "name": "^Framerate Presented$",
      "source": "^PresentMon",
      "staleMs": 3000,
      "demo": 144
    },
    "pump": {
      "name": "^Fan 4$",
      "source": "Aqua Computer Octo",
      "unit": "RPM",
      "demo": 2750
    },
    "water": {
      "name": "^Temperature 2$",
      "source": "Aqua Computer Octo",
      "demo": 31.2
    },
    "fan": {
      "name": "^Fan 1$",
      "source": "Aqua Computer Octo",
      "unit": "RPM",
      "demo": 860
    },
    "flow": {
      "name": "^Flow$",
      "source": "Aqua Computer Octo",
      "demo": 94
    },
    "netDown": {
      "name": "^Current DL rate$",
      "aggregate": "sum",
      "scale": 0.008192,
      "demo": 182.4
    },
    "netUp": {
      "name": "^Current UP rate$",
      "aggregate": "sum",
      "scale": 0.008192,
      "demo": 21.7
    },
