      "source": "Aqua Computer Octo",
      "unit": "RPM",
      "demo": 860
    },
    "flow": {
      "name": "^Flow$",
      "source": "Aqua Computer Octo",
      "demo": 94
    },
    "netDown": {
      "name": "^Current DL rate$",
      "aggregate": "sum",
      "scale": 0.008192,
      "demo": 182.4
    },
    "netUp": {
      "name": "^Current UP rate$",
      "aggregate": "sum",
      "scale": 0.008192,
      "demo": 21.7
