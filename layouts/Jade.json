      "demo": 17.4
    },
    "memTotal": {
      "name": "^Physical Memory (Used|Available)$",
      "aggregate": "sum",
      "scale": 0.0009765625,
      "demo": 61.7
    },
    "memLoad": {
      "name": "^Physical Memory Load$",
      "demo": 28
    },
