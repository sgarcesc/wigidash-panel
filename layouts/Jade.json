      "name": "^GPU Core Load$",
      "source": "^GPU \\[#0\\]",
      "demo": 87
    },
    "vramUsed": {
      "name": "^GPU Memory Allocated$",
      "source": "^GPU \\[#0\\]",
      "scale": 0.0009765625,
      "demo": 11.6
    },
    "vramTotal": {
      "name": "^GPU Memory (Allocated|Available)$",
      "source": "^GPU \\[#0\\]",
      "aggregate": "sum",
      "scale": 0.0009765625,
      "demo": 31.8
    },
    "vramLoad": {
      "name": "^GPU Memory Usage$",
      "source": "^GPU \\[#0\\]",
      "unit": "%",
      "demo": 36
    },
    "fps": {
      "name": "^Framerate Presented$",
      "source": "^PresentMon",
      "staleMs": 3000,
      "demo": 144
    },
    "pump": {
