{
  "name": "Synthwave",
  "canvas": {
    "width": 1024,
    "height": 600,
    "background": "#0B0420"
  },
  "refreshMs": 1000,
  "sensors": {
    "cpuTemp": {
      "name": "^CPU$",
      "source": "^CPU \\[#0\\]",
      "unit": "C",
      "demo": 52
    },
    "cpuClock": {
      "name": "^Core \\d+ Clock$",
      "source": "^CPU \\[#0\\]",
      "aggregate": "avg",
      "demo": 5225
    },
    "cpuPower": {
      "name": "^CPU Package Power$",
      "demo": 63.4
    },
    "cpuLoad": {
      "name": "^Total CPU Usage$",
      "demo": 24
    },
    "memUsed": {
      "name": "^Physical Memory Used$",
      "scale": 0.0009765625,
      "demo": 17.4
    },
    "memTotal": {
      "name": "^Physical Memory (Used|Available)$",
      "aggregate": "sum",
      "scale": 0.0009765625,
      "demo": 61.7
    },
    "memLoad": {
      "name": "^Physical Memory Load$",
      "demo": 28
    },
    "gpuTemp": {
      "name": "^GPU Temperature$",
      "source": "^[di]?GPU \\[#0\\]",
      "demo": 61
    },
    "gpuClock": {
      "name": "^GPU Clock$",
      "source": "^[di]?GPU \\[#0\\]",
      "demo": 2655
    },
    "gpuPower": {
      "name": "^GPU Power$",
      "source": "^[di]?GPU \\[#0\\]",
      "unit": "^W$",
      "demo": 412
    },
    "gpuLoad": {
      "name": "^GPU Core Load$",
      "source": "^[di]?GPU \\[#0\\]",
      "demo": 87
    },
    "vramUsed": {
      "name": "^GPU Memory Allocated$",
      "source": "^[di]?GPU \\[#0\\]",
      "scale": 0.0009765625,
      "demo": 11.6
    },
    "vramTotal": {
      "name": "^GPU Memory (Allocated|Available)$",
      "source": "^[di]?GPU \\[#0\\]",
      "aggregate": "sum",
      "scale": 0.0009765625,
      "demo": 31.8
    },
    "vramLoad": {
      "name": "^GPU Memory Usage$",
      "source": "^[di]?GPU \\[#0\\]",
      "unit": "%",
      "demo": 36
    },
    "fps": {
      "name": "^Framerate Presented$",
      "source": "^PresentMon",
      "staleMs": 3000,
      "demo": 144
    },
    "pump": {
      "name": "^Fan 4$",
      "source": "Aqua Computer Octo",
      "unit": "RPM",
      "demo": 2750
    },
    "water": {
      "name": "^Temperature 2$",
      "source": "Aqua Computer Octo",
      "demo": 31.2
    },
    "fan": {
      "name": "^Fan 1$",
      "source": "Aqua Computer Octo",
      "unit": "RPM",
      "demo": 860
    },
    "flow": {
      "name": "^Flow$",
      "source": "Aqua Computer Octo",
      "demo": 94
    },
    "netDown": {
      "name": "^Current DL rate$",
      "aggregate": "sum",
      "scale": 0.008192,
      "demo": 182.4
    },
    "netUp": {
      "name": "^Current UP rate$",
      "aggregate": "sum",
      "scale": 0.008192,
      "demo": 21.7
    },
    "pin1": {
      "name": "^Pin 1 Current$",
      "source": "WireView",
      "demo": 5.4
    },
    "pin2": {
      "name": "^Pin 2 Current$",
      "source": "WireView",
      "demo": 5.9
    },
