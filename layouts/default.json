{
  // Recreation of the G.Skill AIDA64 "Gskill LCD" SensorPanel, drawn natively.
  // Canvas is the physical 1024x600 screen; the 5x4 widget (1016x592) shows it centred,
  // cropping 4 px on each edge, so AIDA coordinates carry over unchanged.
  "name": "G.Skill dark (AIDA-style)",
  "canvas": { "width": 1024, "height": 600, "background": "#000000" },
  "refreshMs": 1000,

  // Sensor bindings: name/source/unit are case-insensitive regexes matched against
  // the WigiDash Manager (HWiNFO) sensor list. See sensors.txt in the widget folder.
  // "scale" converts units, "demo" is only used by the preview tool.
  "sensors": {
    // Needs "HWiNFO PresentMon sensors" enabled in WigiDash settings. The source is
    // "PresentMon [<foreground app>.exe]" and changes with the app; shows "--" when nothing is presenting.
    "fps":       { "name": "^Framerate Presented$", "source": "^PresentMon", "staleMs": 3000, "demo": 144 },

    // AMD Zen 5 on this board reports the package temperature simply as "CPU".
    "cpuTemp":   { "name": "^(CPU|CPU \\(Tctl/Tdie\\))$", "source": "^CPU \\[#0\\]", "unit": "C", "demo": 62 },
    "cpuLoad":   { "name": "^Total CPU Usage$", "demo": 18 },
    // Average of the per-core clocks (what AIDA showed). "Average Effective Clock" counts sleep time and reads ~0.3 GHz at idle.
    "cpuClock":  { "name": "^Core \\d+ Clock$", "source": "^CPU \\[#0\\]", "aggregate": "avg", "scale": 0.001, "demo": 5.22 },
    "cpuPower":  { "name": "^CPU Package Power$", "demo": 71 },

    "gpuTemp":   { "name": "^GPU Temperature$", "source": "^[di]?GPU \\[#0\\]", "unit": "C", "demo": 48 },
    "gpuLoad":   { "name": "^GPU Core Load$", "source": "^[di]?GPU \\[#0\\]", "demo": 37 },
    "gpuClock":  { "name": "^GPU Clock$", "source": "^[di]?GPU \\[#0\\]", "demo": 2407 },
    "gpuPower":  { "name": "^(Total Board Power|GPU Power)$", "source": "^[di]?GPU \\[#0\\]", "unit": "^W$", "demo": 312 },

    // 12V-2x6 per-pin current (boards that expose it, e.g. ASUS Astral). Edit to match sensors.txt.
    "pin1":      { "name": "Pin ?1 .*Current|12V-2x6 Pin ?1", "demo": 5.1 },
    "pin2":      { "name": "Pin ?2 .*Current|12V-2x6 Pin ?2", "demo": 5.4 },
    "pin3":      { "name": "Pin ?3 .*Current|12V-2x6 Pin ?3", "demo": 4.9 },
    "pin4":      { "name": "Pin ?4 .*Current|12V-2x6 Pin ?4", "demo": 6.3 },
    "pin5":      { "name": "Pin ?5 .*Current|12V-2x6 Pin ?5", "demo": 5.0 },
    "pin6":      { "name": "Pin ?6 .*Current|12V-2x6 Pin ?6", "demo": 5.2 },

    "memLoad":   { "name": "^Physical Memory Load$", "demo": 29 },
    "memUsed":   { "name": "^Physical Memory Used$", "scale": 0.0009765625, "demo": 18.3 },
    "memFree":   { "name": "^Physical Memory Available$", "scale": 0.0009765625, "demo": 43.4 },
    "memClock":  { "name": "^Memory Clock$", "scale": 2, "demo": 6000 },
    "tcas":      { "name": "^Tcas$", "demo": 30 },
    "trcd":      { "name": "^Trcd$", "demo": 36 },
    "trp":       { "name": "^Trp$", "demo": 36 },
    "tras":      { "name": "^Tras$", "demo": 76 },

    "vramLoad":  { "name": "^GPU Memory Usage$", "source": "^[di]?GPU \\[#0\\]", "unit": "%", "demo": 21 },
    "vramUsed":  { "name": "^GPU Memory Allocated$", "source": "^[di]?GPU \\[#0\\]", "scale": 0.0009765625, "demo": 6.8 },
    "vramFree":  { "name": "^GPU Memory Available$", "source": "^[di]?GPU \\[#0\\]", "scale": 0.0009765625, "demo": 25.2 },

    // Cooling loop on the Aqua Computer Octo (AIDA used "Fan #23", "Flow #1", "Temperature #4").
    "pump":      { "name": "^Fan 4$", "source": "Aqua Computer Octo", "unit": "RPM", "demo": 2400 },
    "flow":      { "name": "^Flow$", "source": "Aqua Computer Octo", "demo": 142 },
    "water":     { "name": "^Temperature 4$", "source": "Aqua Computer Octo", "unit": "C", "demo": 29.4 }
  },

  "elements": [
    // ---------------------------------------------------------------- backgrounds
    { "type": "rect", "x": 0,   "y": 427, "w": 1024, "h": 173, "color": "#050505" },
    { "type": "rect", "x": 16,  "y": 113, "w": 488,  "h": 283, "color": "#101010" },
    { "type": "rect", "x": 521, "y": 113, "w": 488,  "h": 283, "color": "#101010" },
    { "type": "rect", "x": 16,  "y": 412, "w": 320,  "h": 173, "color": "#101010" },
    { "type": "rect", "x": 352, "y": 412, "w": 320,  "h": 173, "color": "#101010" },
    { "type": "rect", "x": 689, "y": 412, "w": 320,  "h": 173, "color": "#101010" },

    // ---------------------------------------------------------------- top bar
    { "type": "text", "x": 40,  "y": 38, "text": "{HOSTNAME}", "font": "Segoe UI Black", "size": 24, "color": "#FFFFFF" },
    { "type": "text", "x": 137, "y": 24, "w": 390, "align": "right", "text": "{fps:0}", "font": "Segoe UI Light", "size": 40, "color": "#FFFFFF" },
    { "type": "text", "x": 540, "y": 43, "text": "FPS", "font": "Segoe UI Black", "size": 20, "color": "#FFFFFF" },
    { "type": "text", "x": 986, "y": 22, "align": "right", "text": "{time:HH:mm}", "font": "Segoe UI Light", "size": 42, "color": "#FFFFFF" },

    // ---------------------------------------------------------------- CPU panel
    { "type": "text", "x": 40, "y": 130, "text": "{CPUMODEL}", "font": "Segoe UI Semibold", "size": 15, "color": "#FFFFFF" },
    { "type": "gauge", "x": 47, "y": 196, "w": 162, "thickness": 12, "start": 145, "sweep": 360, "steps": 16,
      "sensor": "cpuTemp", "min": 0, "max": 100, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 44,  "y": 245, "w": 100, "align": "right", "text": "{cpuTemp:0}", "font": "Segoe UI Light", "size": 38, "color": "#FFFFFF" },
    { "type": "text", "x": 146, "y": 258, "text": "°C", "font": "Segoe UI Light", "size": 22, "color": "#FFFFFF" },

    { "type": "bar",  "x": 267, "y": 192, "w": 213, "h": 6, "sensor": "cpuLoad", "min": 0, "max": 100, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 267, "y": 204, "text": "CPU Load", "font": "Segoe UI", "size": 14, "color": "#808080" },
    { "type": "text", "x": 267, "y": 204, "w": 213, "align": "right", "text": "{cpuLoad:0}%", "font": "Segoe UI", "size": 14, "color": "#FFFFFF" },

    { "type": "bar",  "x": 267, "y": 253, "w": 213, "h": 6, "sensor": "cpuClock", "min": 0, "max": 5.6, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 267, "y": 265, "text": "CPU Clock", "font": "Segoe UI", "size": 14, "color": "#808080" },
    { "type": "text", "x": 267, "y": 265, "w": 213, "align": "right", "text": "{cpuClock:0.00} GHz", "font": "Segoe UI", "size": 14, "color": "#FFFFFF" },

    { "type": "bar",  "x": 267, "y": 317, "w": 213, "h": 6, "sensor": "cpuPower", "min": 0, "max": 160, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 267, "y": 329, "text": "CPU Package", "font": "Segoe UI", "size": 14, "color": "#808080" },
    { "type": "text", "x": 267, "y": 329, "w": 213, "align": "right", "text": "{cpuPower:0} W", "font": "Segoe UI", "size": 14, "color": "#FFFFFF" },

    // ---------------------------------------------------------------- GPU panel
    { "type": "text", "x": 545, "y": 130, "text": "{GPUMODEL}", "font": "Segoe UI Semibold", "size": 15, "color": "#FFFFFF" },
    { "type": "gauge", "x": 552, "y": 196, "w": 162, "thickness": 12, "start": 145, "sweep": 360, "steps": 16,
      "sensor": "gpuTemp", "min": 0, "max": 100, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 549, "y": 245, "w": 100, "align": "right", "text": "{gpuTemp:0}", "font": "Segoe UI Light", "size": 38, "color": "#FFFFFF" },
    { "type": "text", "x": 651, "y": 258, "text": "°C", "font": "Segoe UI Light", "size": 22, "color": "#FFFFFF" },

    { "type": "bar",  "x": 772, "y": 192, "w": 213, "h": 6, "sensor": "gpuLoad", "min": 0, "max": 100, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 772, "y": 204, "text": "GPU Load", "font": "Segoe UI", "size": 14, "color": "#808080" },
    { "type": "text", "x": 772, "y": 204, "w": 213, "align": "right", "text": "{gpuLoad:0}%", "font": "Segoe UI", "size": 14, "color": "#FFFFFF" },

    { "type": "bar",  "x": 772, "y": 253, "w": 213, "h": 6, "sensor": "gpuClock", "min": 0, "max": 3200, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 772, "y": 265, "text": "GPU Clock", "font": "Segoe UI", "size": 14, "color": "#808080" },
    { "type": "text", "x": 772, "y": 265, "w": 213, "align": "right", "text": "{gpuClock:0} MHz", "font": "Segoe UI", "size": 14, "color": "#FFFFFF" },

    { "type": "bar",  "x": 772, "y": 317, "w": 213, "h": 6, "sensor": "gpuPower", "min": 0, "max": 600, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 772, "y": 329, "text": "Board Power", "font": "Segoe UI", "size": 14, "color": "#808080" },
    { "type": "text", "x": 772, "y": 329, "w": 213, "align": "right", "text": "{gpuPower:0} W", "font": "Segoe UI", "size": 14, "color": "#FFFFFF" },

    // 12V-2x6 pin currents: green < 3 A, yellow < 6 A, orange < 9 A, red beyond.
    { "type": "bar", "x": 772, "y": 362, "w": 20, "h": 21, "vertical": true, "sensor": "pin1", "min": 0, "max": 12, "bg": "#333333", "color": "#00DF00",
      "thresholds": [ { "at": 3, "color": "#FFF800" }, { "at": 6, "color": "#FF8F00" }, { "at": 9, "color": "#FF0000" } ] },
    { "type": "bar", "x": 802, "y": 362, "w": 20, "h": 21, "vertical": true, "sensor": "pin2", "min": 0, "max": 12, "bg": "#333333", "color": "#00DF00",
      "thresholds": [ { "at": 3, "color": "#FFF800" }, { "at": 6, "color": "#FF8F00" }, { "at": 9, "color": "#FF0000" } ] },
    { "type": "bar", "x": 832, "y": 362, "w": 20, "h": 21, "vertical": true, "sensor": "pin3", "min": 0, "max": 12, "bg": "#333333", "color": "#00DF00",
      "thresholds": [ { "at": 3, "color": "#FFF800" }, { "at": 6, "color": "#FF8F00" }, { "at": 9, "color": "#FF0000" } ] },
    { "type": "bar", "x": 862, "y": 362, "w": 20, "h": 21, "vertical": true, "sensor": "pin4", "min": 0, "max": 12, "bg": "#333333", "color": "#00DF00",
      "thresholds": [ { "at": 3, "color": "#FFF800" }, { "at": 6, "color": "#FF8F00" }, { "at": 9, "color": "#FF0000" } ] },
    { "type": "bar", "x": 892, "y": 362, "w": 20, "h": 21, "vertical": true, "sensor": "pin5", "min": 0, "max": 12, "bg": "#333333", "color": "#00DF00",
      "thresholds": [ { "at": 3, "color": "#FFF800" }, { "at": 6, "color": "#FF8F00" }, { "at": 9, "color": "#FF0000" } ] },
    { "type": "bar", "x": 922, "y": 362, "w": 20, "h": 21, "vertical": true, "sensor": "pin6", "min": 0, "max": 12, "bg": "#333333", "color": "#00DF00",
      "thresholds": [ { "at": 3, "color": "#FFF800" }, { "at": 6, "color": "#FF8F00" }, { "at": 9, "color": "#FF0000" } ] },
    { "type": "text", "x": 985, "y": 365, "align": "right", "text": "12V", "font": "Segoe UI", "size": 11, "color": "#808080" },

    // ---------------------------------------------------------------- RAM (bottom left)
    { "type": "text", "x": 40,  "y": 428, "text": "DDR5-{memClock:0}", "font": "Segoe UI Semibold", "size": 13, "color": "#FFFFFF" },
    { "type": "text", "x": 310, "y": 428, "align": "right", "text": "{tcas:0}-{trcd:0}-{trp:0}-{tras:0}", "font": "Segoe UI", "size": 13, "color": "#C0C0C0" },
    { "type": "bar",  "x": 40,  "y": 460, "w": 270, "h": 12, "sensor": "memLoad", "min": 0, "max": 100, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 40,  "y": 492, "text": "U:", "font": "Segoe UI", "size": 13, "color": "#808080" },
    { "type": "text", "x": 62,  "y": 492, "text": "{memUsed:0.0} GB", "font": "Segoe UI", "size": 13, "color": "#FFFFFF" },
    { "type": "text", "x": 40,  "y": 518, "text": "F:", "font": "Segoe UI", "size": 13, "color": "#808080" },
    { "type": "text", "x": 62,  "y": 518, "text": "{memFree:0.0} GB", "font": "Segoe UI", "size": 13, "color": "#FFFFFF" },
    { "type": "text", "x": 310, "y": 484, "align": "right", "text": "{memLoad:0}%", "font": "Segoe UI Light", "size": 40, "color": "#FFFFFF" },

    // ---------------------------------------------------------------- cooling (bottom middle)
    { "type": "rect", "x": 368, "y": 426, "w": 2, "h": 42, "color": "#FFFFFF" },
    { "type": "text", "x": 378, "y": 424, "text": "PUMP", "font": "Segoe UI Semibold", "size": 11, "color": "#808080" },
    { "type": "bar",  "x": 378, "y": 452, "w": 160, "h": 10, "sensor": "pump", "min": 0, "max": 3000, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 652, "y": 434, "align": "right", "text": "{pump:0} RPM", "font": "Segoe UI Light", "size": 19, "color": "#FFFFFF" },

    { "type": "rect", "x": 368, "y": 481, "w": 2, "h": 42, "color": "#FFFFFF" },
    { "type": "text", "x": 378, "y": 479, "text": "FLOW", "font": "Segoe UI Semibold", "size": 11, "color": "#808080" },
    { "type": "bar",  "x": 378, "y": 507, "w": 160, "h": 10, "sensor": "flow", "min": 0, "max": 180, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 652, "y": 489, "align": "right", "text": "{flow:0} L/h", "font": "Segoe UI Light", "size": 19, "color": "#FFFFFF" },

    { "type": "rect", "x": 368, "y": 536, "w": 2, "h": 42, "color": "#FFFFFF" },
    { "type": "text", "x": 378, "y": 534, "text": "WATER", "font": "Segoe UI Semibold", "size": 11, "color": "#808080" },
    { "type": "bar",  "x": 378, "y": 562, "w": 160, "h": 10, "sensor": "water", "min": 20, "max": 45, "color": "#FFFFFF", "bg": "#363636",
      "thresholds": [ { "at": 38, "color": "#FF8F00" }, { "at": 42, "color": "#FF3030" } ] },
    { "type": "text", "x": 652, "y": 544, "align": "right", "text": "{water:0.0} °C", "font": "Segoe UI Light", "size": 19, "color": "#FFFFFF" },

    // ---------------------------------------------------------------- VRAM (bottom right)
    { "type": "text", "x": 712, "y": 428, "text": "GPU", "font": "Segoe UI Black", "size": 13, "color": "#FFFFFF" },
    { "type": "text", "x": 755, "y": 428, "text": "VRAM", "font": "Segoe UI Light", "size": 13, "color": "#FFFFFF" },
    { "type": "bar",  "x": 712, "y": 460, "w": 270, "h": 12, "sensor": "vramLoad", "min": 0, "max": 100, "color": "#FFFFFF", "bg": "#363636" },
    { "type": "text", "x": 712, "y": 492, "text": "U:", "font": "Segoe UI", "size": 13, "color": "#808080" },
    { "type": "text", "x": 734, "y": 492, "text": "{vramUsed:0.0} GB", "font": "Segoe UI", "size": 13, "color": "#FFFFFF" },
    { "type": "text", "x": 712, "y": 518, "text": "F:", "font": "Segoe UI", "size": 13, "color": "#808080" },
    { "type": "text", "x": 734, "y": 518, "text": "{vramFree:0.0} GB", "font": "Segoe UI", "size": 13, "color": "#FFFFFF" },
    { "type": "text", "x": 982, "y": 484, "align": "right", "text": "{vramLoad:0}%", "font": "Segoe UI Light", "size": 40, "color": "#FFFFFF" }
  ]
}
