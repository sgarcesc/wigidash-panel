<Project>
  <PropertyGroup>
    <!-- net472 projects default to auditing direct packages only; also report vulnerable transitive ones. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- New compiler warnings fail the build. NuGet audit warnings stay warnings: a newly published
         advisory (NU1901-NU1904) shouldn't break every build, Dependabot handles those, and an
         unreachable or empty vulnerability feed (NU1900, NU1905) shouldn't fail restore offline or
         during an outage. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
